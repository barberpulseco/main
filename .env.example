# ---- Required ----
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ca-central-1.pooler.supabase.com:6543/postgres
# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # server-only, never put this in frontend code
SUPABASE_BUCKET=shoot-photos            # create as a PRIVATE bucket
# Any long random string: `openssl rand -hex 32`
SESSION_SECRET=
# Ethan's admin login, created automatically on first boot
ADMIN_EMAIL=barberpulseco@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Ethan
SITE_URL=https://barberpulse.co

# ---- Payments (Stripe) ----
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...         # webhook endpoint: https://barberpulse.co/api/stripe/webhook

# ---- Optional ----
# Better nearby-shop results (Places API (New)). Without it, OpenStreetMap is used.
GOOGLE_MAPS_API_KEY=
# Local testing only: lets the "Unlock" button mark photos paid without Stripe.
# DEMO_PAYMENTS=1
